generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         UserRole      @default(CASHIER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cashSessions CashSession[]
  orders       Order[]
  refundsRequested Refund[] @relation("RefundRequestedBy")
  refundsConfirmed Refund[] @relation("RefundConfirmedBy")

  @@index([role])
  @@index([isActive])
}

model Store {
  id           String        @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cashSessions CashSession[]
  customers    Customer[]
  expenses     Expense[]
  orders       Order[]
  products     Product[]
  promotions   Promotion[]
  purchases    Purchase[]
  suppliers    Supplier[]
}

model Product {
  id             String          @id @default(cuid())
  storeId        String
  name           String
  sku            String
  barcode        String?
  category       String?
  description    String?
  purchasePrice  Decimal         @db.Decimal(12, 2)
  sellingPrice   Decimal         @db.Decimal(12, 2)
  stock          Int             @default(0)
  minimumStock   Int             @default(5)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  promotionItems PromotionItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([barcode])
  @@index([category])
  @@index([isActive])
}

model Customer {
  id            String         @id @default(cuid())
  storeId       String
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int            @default(0)
  totalSpent    Decimal        @default(0) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberCode    String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders        Order[]
  pointHistory  PointHistory[]

  @@unique([storeId, memberCode])
  @@index([storeId])
  @@index([phone])
  @@index([email])
}

model PointHistory {
  id          String               @id @default(cuid())
  customerId  String
  orderId     String?
  type        PointTransactionType
  points      Int
  balance     Int
  description String?
  createdAt   DateTime             @default(now())
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?               @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model Supplier {
  id        String     @id @default(cuid())
  storeId   String
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  storeId        String
  supplierId     String?
  total          Decimal        @db.Decimal(12, 2)
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]

  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  cost       Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  storeId        String
  cashierId      String
  customerId     String?
  customerName   String?
  promotionId    String?
  subtotal       Decimal        @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  tax            Decimal        @default(0) @db.Decimal(12, 2)
  serviceCharge  Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  status         OrderStatus    @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  pointsDiscount Decimal        @default(0) @db.Decimal(12, 2)
  pointsUsed     Int            @default(0)
  cashier        User           @relation(fields: [cashierId], references: [id])
  customer       Customer?      @relation(fields: [customerId], references: [id])
  promotion      Promotion?     @relation(fields: [promotionId], references: [id])
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  payment        Payment?
  pointHistory   PointHistory[]
  refunds        Refund[]
  receipt        Receipt?

  @@index([storeId])
  @@index([cashierId])
  @@index([customerId])
  @@index([promotionId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  amount            Decimal        @db.Decimal(12, 2)
  provider          String?
  providerPaymentId String?
  externalOrderId   String?
  qrString          String?
  qrUrl             String?
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cashReceived      Decimal?       @db.Decimal(12, 2)
  changeAmount      Decimal?       @db.Decimal(12, 2)
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@index([status])
  @@index([provider])
  @@index([providerPaymentId])
  @@index([externalOrderId])
}

model PaymentEvent {
  id          String    @id @default(cuid())
  paymentId   String
  provider    String
  eventId     String?
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([processed])
}

model Receipt {
  id            String    @id @default(cuid())
  orderId       String    @unique
  receiptNumber String    @unique
  printedAt     DateTime?
  createdAt     DateTime  @default(now())
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  type        StockMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  referenceId String?
  notes       String?
  createdAt   DateTime          @default(now())
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model CashSession {
  id          String            @id @default(cuid())
  storeId     String
  cashierId   String
  openingCash Decimal           @db.Decimal(12, 2)
  closingCash Decimal?          @db.Decimal(12, 2)
  status      CashSessionStatus
  openedAt    DateTime          @default(now())
  closedAt    DateTime?
  cashier     User              @relation(fields: [cashierId], references: [id])
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([cashierId])
  @@index([status])
}

model Promotion {
  id              String          @id @default(cuid())
  storeId         String
  name            String
  code            String?
  description     String?
  type            DiscountType
  value           Decimal         @db.Decimal(12, 2)
  minimumPurchase Decimal?        @db.Decimal(12, 2)
  startAt         DateTime
  endAt           DateTime
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          Order[]
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items           PromotionItem[]

  @@index([storeId])
  @@index([code])
  @@index([isActive])
  @@index([startAt, endAt])
}

model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
}


model Expense {
  id            String   @id @default(cuid())
  storeId       String
  description   String
  category      String?
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime @default(now())
  dueDate       DateTime?
  paymentStatus String   @default("UNPAID")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([expenseDate])
  @@index([dueDate])
  @@index([paymentStatus])
}


model Refund {
  id            String       @id @default(cuid())
  orderId       String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        RefundStatus @default(PENDING)
  requestedById String
  confirmedById String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?

  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  confirmedBy User?  @relation("RefundConfirmedBy", fields: [confirmedById], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([requestedById])
  @@index([confirmedById])
}

enum RefundStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  QRIS
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  E_WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum PointTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
}
